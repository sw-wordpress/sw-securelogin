{
  "name": "sw/securelogin",
  "description": "Modular authentication for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "ext-openssl": "*",
    "lbuchs/webauthn": "^2.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "SW\\Securelogin\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true,
    "audit": {
      "abandoned": "report"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=512M",
    "cs": "@php vendor/bin/phpcs",
    "lint": "find src tests bin sw-securelogin.php uninstall.php -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test:integration": "@php vendor/bin/phpunit -c phpunit.integration.xml.dist",
    "build:prefixed": "bash bin/build-prefixed.sh",
    "test:mozart": "bash tests/Build/mozart-smoke.sh",
    "test:coverage": "@php vendor/bin/phpunit --coverage-clover coverage/unit.xml --fail-on-warning",
    "test:integration:coverage": "@php vendor/bin/phpunit -c phpunit.integration.xml.dist --coverage-clover coverage/wordpress.xml --fail-on-warning",
    "coverage:merge": "@php tests/coverage/merge.php coverage/clover.xml coverage/unit.xml coverage/wordpress.xml",
    "coverage:check": "@php tests/coverage/check.php coverage/clover.xml",
    "stan": "@analyse"
  },
  "extra": {
    "mozart": {
      "dep_namespace": "SW\\Securelogin\\Dependencies\\",
      "dep_directory": "/vendor-prefixed/",
      "classmap_directory": "/vendor-prefixed/",
      "classmap_prefix": "SWSL_",
      "constant_prefix": "SWSL_",
      "functions_prefix": "swsl_",
      "generate_autoloader": true,
      "delete_vendor_directories": true
    }
  }
}
