#: sw-securelogin.php
#: src/Admin/SettingsPage.php:19
#: src/Admin/SettingsPage.php:20
#: src/Admin/SettingsPage.php:33
msgid "SW Securelogin"
msgstr "SW Securelogin"

#. Description of the plugin
#: sw-securelogin.php
msgid "Modular authentication platform. Passkey registration and login preview; password login remains available."
msgstr "Modulare Authentifizierungsplattform. Vorschau der Passkey-Registrierung und -Anmeldung; die Passwortanmeldung bleibt verfügbar."

#: src/Admin/SettingsPage.php:34
msgid "Passkey registration and login can be enabled below. Password login remains available."
msgstr "Passkey-Registrierung und -Anmeldung können unten aktiviert werden. Die Passwortanmeldung bleibt verfügbar."

#: src/Admin/SettingsPage.php:35
msgid "Modules"
msgstr "Module"

#: src/Admin/SettingsPage.php:36
msgid "Passkeys — registration and login"
msgstr "Passkeys — Registrierung und Anmeldung"

#: src/Admin/SettingsPage.php:37
msgid "External OpenID Connect login — planned for version 1.1+"
msgstr "Externe OpenID-Connect-Anmeldung — geplant für Version 1.1+"

#: src/Admin/SettingsPage.php:38
msgid "Authorization Server — requires a separate security review"
msgstr "Autorisierungsserver — erfordert eine separate Sicherheitsprüfung"

#: src/Admin/SettingsPage.php:39
msgid "Security status"
msgstr "Sicherheitsstatus"

#: src/Admin/SettingsPage.php:41
msgid "HTTPS is active for this request."
msgstr "HTTPS ist für diese Anfrage aktiv."

#: src/Admin/SettingsPage.php:42
msgid "HTTPS is required before authentication modules can be used."
msgstr "HTTPS ist erforderlich, bevor Authentifizierungsmodule verwendet werden können."

#: src/Core/MigrationRunner.php:55
msgid "SW Securelogin database upgrade is unavailable. Please retry."
msgstr "Die Datenbankaktualisierung von SW Securelogin ist nicht verfügbar. Bitte erneut versuchen."

#: src/Core/MigrationRunner.php:63
msgid "SW Securelogin database upgrade failed. Authentication modules remain disabled."
msgstr "Die Datenbankaktualisierung von SW Securelogin ist fehlgeschlagen. Authentifizierungsmodule bleiben deaktiviert."

#: src/Core/Plugin.php:64
msgid "SW Securelogin is currently available for single-site installations only."
msgstr "SW Securelogin ist derzeit nur für Einzelinstallationen verfügbar."

#: src/Modules/Passkeys/LoginController.php:278
#: src/Modules/Passkeys/LoginPage.php:33
msgid "Passkey authentication could not be completed. Retry or sign in with your password."
msgstr "Die Passkey-Bestätigung konnte nicht abgeschlossen werden. Versuche es erneut oder melde dich mit deinem Passwort an."

#: src/Modules/Passkeys/LoginPage.php:34
msgid "Enter your username or email address to sign in with a passkey."
msgstr "Gib deinen Benutzernamen oder deine E-Mail-Adresse ein, um dich mit einem Passkey anzumelden."

#: src/Modules/Passkeys/LoginPage.php:35
#: src/Modules/Passkeys/ProfileController.php:46
msgid "Passkeys require a supported browser and a secure connection."
msgstr "Passkeys erfordern einen unterstützten Browser und eine sichere Verbindung."

#: src/Modules/Passkeys/LoginPage.php:42
msgid "Sign in with a passkey"
msgstr "Mit Passkey anmelden"

#: src/Modules/Passkeys/LoginPage.php:43
msgid "Enter your username or email address above, then use a passkey."
msgstr "Gib oben deinen Benutzernamen oder deine E-Mail-Adresse ein und verwende dann einen Passkey."

#: src/Modules/Passkeys/LoginPage.php:46
msgid "Log in with password"
msgstr "Mit Passwort anmelden"

#: src/Modules/Passkeys/PasskeysModule.php:131
#: src/Modules/Passkeys/PrivacyController.php:62
#: src/Modules/Passkeys/PrivacyController.php:75
#: src/Modules/Passkeys/PrivacyController.php:101
msgid "Passkeys"
msgstr "Passkeys"

#: src/Modules/Passkeys/PasskeysModule.php:135
msgid "Additional authentication extensions require a reviewed passkey adapter. Password login remains available."
msgstr "Zusätzliche Authentifizierungserweiterungen benötigen einen geprüften Passkey-Adapter. Die Passwortanmeldung bleibt verfügbar."

#: src/Modules/Passkeys/PasskeysModule.php:137
msgid "Requires HTTPS. Enabling pins the configured site origin; domain changes require a separate migration."
msgstr "Erfordert HTTPS. Bei der Aktivierung wird die konfigurierte Website-Origin festgelegt; Domainänderungen erfordern eine separate Migration."

#: src/Modules/Passkeys/PasskeysModule.php:140
msgid "Enable passkey registration and login"
msgstr "Passkey-Registrierung und -Anmeldung aktivieren"

#: src/Modules/Passkeys/PasskeysModule.php:141
msgid "Save"
msgstr "Speichern"

#: src/Modules/Passkeys/PasskeysModule.php:148
#: src/Modules/Passkeys/PasskeysModule.php:152
#: src/Modules/Passkeys/PasskeysModule.php:157
msgid "Access denied."
msgstr "Zugriff verweigert."

#: src/Modules/Passkeys/PasskeysModule.php:164
msgid "Passkey configuration could not be saved. Check HTTPS and the pinned site origin."
msgstr "Die Passkey-Konfiguration konnte nicht gespeichert werden. Prüfen Sie HTTPS und die festgelegte Website-Origin."

#: src/Modules/Passkeys/PrivacyController.php:128
msgid "Passkey data could not be erased. Please retry."
msgstr "Passkey-Daten konnten nicht gelöscht werden. Bitte erneut versuchen."

#: src/Modules/Passkeys/ProfileController.php:42
msgid "Registered (UTC)"
msgstr "Registriert (UTC)"

#: src/Modules/Passkeys/ProfileController.php:43
msgid "Last used (UTC)"
msgstr "Zuletzt verwendet (UTC)"

#: src/Modules/Passkeys/ProfileController.php:44
msgid "Never"
msgstr "Noch nie"

#: src/Modules/Passkeys/ProfileController.php:45
#: src/Modules/Passkeys/RegistrationController.php:239
msgid "The passkey operation could not be completed. Confirm again with your password or a passkey and retry."
msgstr "Der Passkey-Vorgang konnte nicht abgeschlossen werden. Bestätige erneut mit deinem Passwort oder einem Passkey und versuche es noch einmal."

#: src/Modules/Passkeys/ProfileController.php:47
msgid "No passkeys registered."
msgstr "Keine Passkeys registriert."

#: src/Modules/Passkeys/ProfileController.php:48
msgid "Rename"
msgstr "Umbenennen"

#: src/Modules/Passkeys/ProfileController.php:49
msgid "Revoke"
msgstr "Widerrufen"

#: src/Modules/Passkeys/ProfileController.php:50
#: src/Modules/Passkeys/ProfileController.php:75
msgid "Passkey name"
msgstr "Passkey-Name"

#: src/Modules/Passkeys/ProfileController.php:51
msgid "Passkey operation completed."
msgstr "Passkey-Vorgang abgeschlossen."

#: src/Modules/Passkeys/ProfileController.php:65
msgid "My passkeys"
msgstr "Meine Passkeys"

#: src/Modules/Passkeys/ProfileController.php:66
msgid "Manage the passkeys linked to your account."
msgstr "Verwalte die mit deinem Konto verknüpften Passkeys."

#: src/Modules/Passkeys/ProfileController.php:67
msgid "Use your passkeys to sign in. Password login remains available."
msgstr "Melde dich mit deinen Passkeys an. Die Passwortanmeldung bleibt verfügbar."

#: src/Modules/Passkeys/ProfileController.php:68
msgid "Confirm each change"
msgstr "Jede Änderung bestätigen"

#: src/Modules/Passkeys/ProfileController.php:69
msgid "Confirm with your password or an existing passkey before each change. The password field is cleared after confirmation."
msgstr "Bestätige jede Änderung mit deinem Passwort oder einem vorhandenen Passkey. Das Passwortfeld wird nach der Bestätigung geleert."

#: src/Modules/Passkeys/ProfileController.php:70
msgid "Confirm with"
msgstr "Bestätigen mit"

#: src/Modules/Passkeys/ProfileController.php:70
msgid "Password"
msgstr "Passwort"

#: src/Modules/Passkeys/ProfileController.php:70
msgid "Existing passkey"
msgstr "Vorhandener Passkey"

#: src/Modules/Passkeys/ProfileController.php:71
msgid "Current password"
msgstr "Aktuelles Passwort"

#: src/Modules/Passkeys/ProfileController.php:73
msgid "Add a new passkey"
msgstr "Neuen Passkey hinzufügen"

#: src/Modules/Passkeys/ProfileController.php:74
msgid "Choose a name that helps you recognize this passkey later."
msgstr "Wähle einen Namen, an dem du diesen Passkey später wiedererkennst."

#: src/Modules/Passkeys/ProfileController.php:76
msgid "Add passkey"
msgstr "Passkey hinzufügen"

#: src/Modules/Passkeys/ProfileController.php:77
msgid "Registered passkeys"
msgstr "Registrierte Passkeys"

#: sw-securelogin.php:42
msgid "SW Securelogin requires its Composer dependencies. Run composer install in the plugin directory."
msgstr "SW Securelogin benötigt seine Composer-Abhängigkeiten. Führen Sie composer install im Pluginverzeichnis aus."
